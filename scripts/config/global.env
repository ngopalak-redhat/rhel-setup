# Required: Azure Resource Group name (script will fail if left empty)
RESOURCE_GROUP=""
OWNER=""

# Optional parameters with default fallback values
LOCATION="centralindia"
# INSTANCE_NAME="" # Defaults to "${RESOURCE_GROUP}-azure-host" if omitted
ADMIN_USER="core"
SSH_KEY_PUB="${HOME}/.ssh/id_rsa.pub"
OS_DISK_SIZE_GB=120
IMAGE="RedHat:RHEL:9-lvm-gen2:latest"

# Spot VM Configuration
VM_PRIORITY="Spot"
EVICTION_POLICY="Deallocate"
MAX_PRICE="-1"